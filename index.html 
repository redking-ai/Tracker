  <script>
  (function () {
    // Sound engine using pure Web Audio API (zero external assets)
    let audioCtx = null;
    let soundEnabled = true;

    function initAudio() {
      if (!audioCtx) {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioCtx();
      }
      if (audioCtx && audioCtx.state === "suspended") {
        audioCtx.resume();
      }
    }

    function playPop() {
      if (!soundEnabled) return;
      initAudio();
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(380, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(750, audioCtx.currentTime + 0.08);
      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.09);
    }

    function playChime() {
      if (!soundEnabled) return;
      initAudio();
      if (!audioCtx) return;
      const freqs = [523.25, 659.25, 783.99, 1046.5];
      freqs.forEach(function (f, i) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(f, audioCtx.currentTime + i * 0.07);
        gain.gain.setValueAtTime(0.22, audioCtx.currentTime + i * 0.07);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + i * 0.07 + 0.5);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(audioCtx.currentTime + i * 0.07);
        osc.stop(audioCtx.currentTime + i * 0.07 + 0.55);
      });
    }

    // Elements
    const stage = document.getElementById("stage");
    const card = document.getElementById("card");
    const title = document.getElementById("title");
    const subtitle = document.getElementById("subtitle");
    const tagName = document.getElementById("tag-name");
    const nameDrawer = document.getElementById("name-drawer");
    const nameInput = document.getElementById("name-input");
    const btnEdit = document.getElementById("btn-edit");
    const btnSound = document.getElementById("btn-sound");
    const mediaFrame = document.getElementById("media-frame");
    const letterView = document.getElementById("letter-view");
    const letterRecipient = document.getElementById("letter-recipient");
    const letterClose = document.getElementById("letter-close");
    const gif = document.getElementById("valentine-gif");
    const btnYes = document.getElementById("btn-yes");
    const btnNo = document.getElementById("btn-no");
    const actionRow = document.getElementById("action-row");

    let partnerName = "Mary";
    let isAccepted = false;
    let isLetterOpen = false;

    // Theme Switcher - SYNC ENTIRE BODY BACKGROUND
    const themes = ["sakura", "midnight", "sunset", "vanilla"];
    themes.forEach(function (t) {
      document.getElementById("dot-" + t).addEventListener("click", function () {
        themes.forEach(function (other) {
          stage.classList.remove("theme-" + other);
          document.body.classList.remove("theme-" + other);
          document.getElementById("dot-" + other).classList.remove("active");
        });
        stage.classList.add("theme-" + t);
        document.body.classList.add("theme-" + t);
        this.classList.add("active");
      });
    });

    // Sound toggle
    btnSound.addEventListener("click", function () {
      soundEnabled = !soundEnabled;
      btnSound.textContent = soundEnabled ? "🔔" : "🔕";
    });

    // Custom Name Drawer
    btnEdit.addEventListener("click", function () {
      nameDrawer.classList.toggle("open");
      btnEdit.classList.toggle("active");
      if (nameDrawer.classList.contains("open")) {
        nameInput.focus();
      }
    });

    function getFormattedName(val) {
      const trimmed = val.trim();
      if (!trimmed) return "Mary";
      return trimmed.charAt(0).toUpperCase() + trimmed.slice(1);
    }

    nameInput.addEventListener("input", function () {
      partnerName = getFormattedName(nameInput.value);
      tagName.textContent = "SPECIAL FOR " + partnerName.toUpperCase();
      letterRecipient.textContent = "Dearest " + partnerName + ",";
      if (!isAccepted) {
        title.innerHTML = partnerName + ', will you be mine? <span class="pulse-emoji">💖</span>';
      } else {
        title.innerHTML = 'I knew it! I love you, ' + partnerName + ' <span class="pulse-emoji">😘</span>';
      }
    });

    // Dodging No Button
    const dodgeHints = [
      "No 💔",
      "Are you sure? 🥺",
      "Think again! 🌸",
      "Can't catch me! 🏃‍♀️",
      "Nice try! 💖",
      "Say Yes! ✨"
    ];
    let dodgeCount = 0;

    function moveNoButton() {
      playPop();
      const newX = (Math.random() - 0.5) * 170;
      const newY = (Math.random() - 0.5) * 80;
      btnNo.style.transform = "translate(" + newX + "px, " + newY + "px)";
      dodgeCount++;
      btnNo.textContent = dodgeHints[dodgeCount % dodgeHints.length];
    }

    btnNo.addEventListener("mouseover", moveNoButton);
    btnNo.addEventListener("touchstart", function (e) {
      e.preventDefault();
      moveNoButton();
    }, { passive: false });
    btnNo.addEventListener("focus", function (e) {
      e.preventDefault();
      moveNoButton();
    });

    // Toggle Love Letter View
    function toggleLetter() {
      isLetterOpen = !isLetterOpen;
      if (isLetterOpen) {
        mediaFrame.style.display = "none";
        letterView.classList.add("open");
      } else {
        letterView.classList.remove("open");
        mediaFrame.style.display = "flex";
      }
      const openBtn = document.getElementById("btn-open-letter");
      if (openBtn) {
        openBtn.textContent = isLetterOpen ? "Hide Letter ✉️" : "Read Love Letter 💌";
      }
    }

    letterClose.addEventListener("click", toggleLetter);

    // Yes celebration
    btnYes.addEventListener("click", function () {
      isAccepted = true;
      playChime();
      card.classList.add("celebrating");
      title.innerHTML = 'I knew it! I love you, ' + partnerName + ' <span class="pulse-emoji">😘</span>';
      subtitle.textContent = "You just made me the happiest person in the universe! ✨";
      gif.src = "https://media.giphy.com/media/UMon0fuimoAN9ueUNP/giphy.gif";

      actionRow.innerHTML = 
        '<div class="celebration-box">' +
          '<div class="celebration-actions">' +
            '<div class="celebration-pill"><span class="ring-icon">💍</span> Forever &amp; Always 💕</div>' +
            '<button class="open-letter-btn" id="btn-open-letter">Read Love Letter 💌</button>' +
          '</div>' +
          '<button class="replay-link" id="btn-replay">replay this moment ↺</button>' +
        '</div>';

      document.getElementById("btn-open-letter").addEventListener("click", toggleLetter);
      document.getElementById("btn-replay").addEventListener("click", function () {
        location.reload();
      });

      // Confetti Explosion
      const palette = ["#ff3366", "#ff5376", "#ff758c", "#ff9bb2", "#ffb199", "#ffd166", "#a18cd1", "#fbc2eb"];
      const chars = ["♥", "♡", "✨", "🌸", "💖", "★"];
      for (let i = 0; i < 32; i++) {
        const angle = (Math.PI * 2 * i) / 32 + (Math.random() - 0.5) * 0.4;
        const dist = 75 + Math.random() * 105;
        const dx = Math.cos(angle) * dist;
        const dy = Math.sin(angle) * dist - 45;
        const scale = 0.8 + Math.random() * 0.7;

        const mote = document.createElement("span");
        mote.className = "burst-mote";
        mote.textContent = chars[Math.floor(Math.random() * chars.length)];
        mote.style.color = palette[Math.floor(Math.random() * palette.length)];
        mote.style.left = "190px";
        mote.style.top = "270px";
        mote.style.setProperty("--dx", dx + "px");
        mote.style.setProperty("--dy", dy + "px");
        mote.style.setProperty("--sc", scale);
        card.appendChild(mote);

        setTimeout(function () {
          mote.remove();
        }, 900);
      }
    });
  })();
  </script>
<script></script></body>
</html>