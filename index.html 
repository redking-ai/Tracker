  }

  /* Main Card */
  .valentine-card {
    width: 100%;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 245, 247, 0.93) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.85);
